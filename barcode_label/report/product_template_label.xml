<?xml version="1.0" encoding="utf-8"?>
<odoo>
    5041
    5041
    <template id="report_producttemplatelabel5x6">
        <t t-call="web.html_container">
            <style>
                            html, body {
                                margin: 0 !important;
                                padding: 0 !important;
                            }

                            .page {
                                page-break-inside: avoid !important;
                                break-inside: avoid !important;
                            }

                            table, tr, td {
                                page-break-inside: avoid !important;
                                break-inside: avoid !important;
                            }
            </style>
            <t t-foreach="label_pages" t-as="label_page">
                <div
                    t-attf-style="width:120mm;
                    height:19.5mm;
                    margin:0;
                    padding:0;
                    overflow:hidden;#{'' if label_page_last else 'page-break-after:always;'}">
                    <table style="width:108mm;border-collapse:collapse;table-layout:fixed;box-sizing:border-box;">
                        <colgroup>
                            <col style="width:21.6mm;"/>
                            <col style="width:21.6mm;"/>
                            <col style="width:21.6mm;"/>
                            <col style="width:21.6mm;"/>
                            <col style="width:21.6mm;"/>
                        </colgroup>
                        <tr>
                            <t t-foreach="range(5)" t-as="col_idx">
                                <t t-if="col_idx &lt; len(label_page)">
                                    <t t-set="product" t-value="label_page[col_idx][0]"/>
                                    <t t-set="barcode" t-value="label_page[col_idx][1]"/>
                                        <td style="width:21.6mm;height:20mm;vertical-align:top;padding:2mm 0 0 0;border:none;text-align:center;">
                                            <t t-if="barcode">
                                                <div t-out="barcode"
                                                     t-options="{'widget': 'barcode', 'symbology': 'auto', 'img_style': 'width:25mm;height:7mm;display:block;'}"/>
                                                <div style="position:relative;left:7.5px;">
                                                <div style="font-size:9px;font-weight:700;line-height:1.5;margin-top:1.5mm;" t-out="barcode"/>
                                                <div style="font-size:8px;font-weight:700;" t-field="product.default_code"/>
                                                </div>
                                            </t>
                                        </td>
<!--                                    <td style="width:21.6mm;height:20mm;vertical-align:top;padding:2mm 0 0 0;box-sizing:border-box;border:none;">-->
<!--                                        <t t-if="barcode">-->
<!--                                            <div t-out="barcode"-->
<!--                                                 t-options="{'widget': 'barcode', 'symbology': 'auto', 'img_style': 'width:25mm;height:7mm;align-content:center !important;'}"/>-->
<!--                                            <div style="font-size:9px;font-weight:700;line-height:1.5;margin-top:1.5mm;text-align:center;" t-out="barcode"/>-->
<!--                                            <div style="font-size:8px;font-weight:700;text-align:center;" t-field="product.default_code"/>-->
<!--                                        </t>-->
<!--                                    </td>-->
                                    </t>

                                <t t-else="">
                                    <td style="width:21.6mm;height:20mm;padding:0;box-sizing:border-box;border:none;"/>
                                </t>
                            </t>
                        </tr>
                    </table>
                </div>
            </t>
        </t>
    </template>
<record id="paperformat_5_12_scrap_reports" model="report.paperformat">
    <field name="name">Barcode Label Paper Format</field>
    <field name="default" eval="True"/>
    <field name="format">custom</field>
    <field name="page_height">21</field>
    <field name="page_width">120</field>
    <field name="orientation">Portrait</field>
    <field name="margin_top">0</field>
    <field name="margin_bottom">0</field>
    <field name="margin_left">0</field>
    <field name="margin_right">0</field>
    <field name="header_line" eval="False"/>
    <field name="header_spacing">0</field>
    <field name="dpi">90</field>
    <field name="disable_shrinking" eval="True"/>
</record>
<record id="report_product_template_label_5x6_noprice" model="ir.actions.report">
    <field name="name">Product Label 5x6 (PDF)</field>
    <field name="model">product.template</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">barcode_label.report_producttemplatelabel5x6</field>
    <field name="report_file">barcode_label.report_producttemplatelabel5x6</field>
    <field name="paperformat_id" ref="barcode_label.paperformat_5_12_scrap_reports"/>
    <field name="print_report_name">'Products Labels - %s' % (object.name)</field>
    <field name="binding_model_id" eval="False"/>
    <field name="binding_type">report</field>
</record>
</odoo>
