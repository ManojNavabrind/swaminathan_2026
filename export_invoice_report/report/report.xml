<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_export_invoice_report" model="ir.actions.report">
        <field name="name">Export Invoice</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">export_invoice_report.export_invoice_report</field>
        <field name="report_file">export_invoice_report.export_invoice_report</field>
        <field name="print_report_name">('Export Invoice - %s' % object.name)</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
    </record>


    <template id="export_invoice_report">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <link rel="stylesheet" type="text/css" href="/export_invoice_report/static/src/css/font.css"/>
                <div class="font-roboto-thin">
                    <div class="header">
                        <t t-foreach="docs" t-as="o">
                            <div style="float:left;width:100%;color: #666;font-weight:bold;line-height:1.5;">
                                <div style="float:left;width:60%;margin-top:15px;">
                                    <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)"
                                         style="max-width: 60%;"/>
                                </div>
                               <div style="float:right;width: 40%;text-align:right;color: #666;">
<!--                                    <t t-esc="o.company_id.name"/>-->
                                    <t t-if="o.company_id.street">
                                        <br/>
                                        <t t-esc="o.company_id.street"/>
                                        <br/>
                                    </t>
                                    <t t-if="o.company_id.street2">
                                        <t t-esc="o.company_id.street2"/>
                                        <br/>
                                    </t>

                                        <t t-esc="o.company_id.city"/><span>,</span>
                                        Pin - <t t-esc="o.company_id.zip"/>
                                        <br/>

                                    <t t-esc="o.company_id.state_id.name"/><span>,</span>
                                    <t t-esc="o.company_id.country_id.name"/>
                                    <br/>
                                    <t t-if="o.company_id.vat">
                                          <span>GSTIN: <t t-esc="o.company_id.vat"/></span>
                                    </t><br/>
                                      <t t-if="o.company_id.pan_no">
                                          <span>PAN: <t t-esc="o.company_id.pan_no"/></span>
                                      </t>
                                </div>

                            </div>
                        </t>

                        <div style="clear:both;"></div>
                        <div style="border-top: 1px solid #DEDBDA; color:#DEDBDA; margin-top: 20px;"/>
                    </div>
                    <br/>
                    <br/>
                    <t t-foreach="docs" t-as="o">

                        <t t-if="o.partner_id.country_id.code != 'IN'">
                            <h4 style="text-align:center;color:#817E7E">
                                <strong>Export Invoice
                                    <t t-esc="o.name"/>
                                </strong>

                            </h4>
                            <br/>
                            <t t-set="sale_orders" t-value="o.mapped('invoice_line_ids.sale_line_ids.order_id')"/>
                            <t t-foreach="sale_orders" t-as="sale_order">
                                <t t-if="o.name in sale_order.invoice_ids.mapped('name')">
                                    <t t-set="sale_order_no" t-value="sale_order.name"/>
                                </t>
                            </t>
                            <t t-set="delivery"
                               t-value="request.env['stock.picking'].sudo().search([('origin','=',sale_order_no)])"/>
                            <t t-set="account"
                               t-value="request.env['res.partner.bank'].sudo().search([('partner_id','=',o.partner_id.id)],limit=1)"/>
                            <br/>
                            <table style="width: 100%;border: 1px; border-collapse: collapse;">
                                <tr>
                                    <td style="width: 25%;padding:4px 12px;">
                                        <strong>Invoice No</strong><br/>
                                        <t t-esc="o.name"/>
                                    </td>
                                    <td style="width: 25%;padding:4px 12px;">
                                        <strong>Invoice Date</strong><br/>
                                        <t t-esc="o.invoice_date" t-options='{"widget": "date","format": "dd-MM-yyyy"}'/>
                                    </td>
                                    <td colspan="2" style="width: 25%;padding:4px 12px;">
                                        <strong>Exporter's Ref</strong><br/>
                                        <t t-esc="delivery.expoter_ref"/>
                                    </td>
                                    <td colspan="2" style="width: 25%;padding:4px 12px;">
                                        <strong>IEC No</strong><br/>
                                        <t t-esc="delivery.iec_no"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding:4px 12px">
                                        <strong>Buyer's Order No</strong>
                                        <br/>
                                        <t t-esc="delivery.buyer_order_no"/>
                                        <br/>
                                        <br/>
                                    </td>
                                    <td style="padding:4px 12px">
                                        <strong>Buyer's Date</strong>
                                        <br/>
                                        <t t-esc="delivery.buyer_date"
                                           t-options='{"widget": "date","format": "dd-MM-yyyy"}'/>
                                        <br/>
                                        <br/>
                                    </td>
                                    <td colspan="4" style="padding:4px 12px;">
                                        <strong>Other Reference</strong>
                                        <br/>
                                        <t t-esc="o.narration"/>
                                    </td>
                                </tr>
<!--                                <tr>-->
<!--                                    <td colspan="2" style="padding:4px 12px;">-->
<!--                                        <strong>Buyer's Order No</strong><br/>-->
<!--                                        <t t-esc="delivery.buyer_order_no"/>-->
<!--                                    </td>-->
<!--                                    <td rowspan="2" colspan="4" style="padding:4px 12px;">-->
<!--                                       <strong>Other Reference</strong><br/>-->
<!--                                           <t t-esc="o.ref"/>-->
<!--                                    </td>-->
<!--                                </tr>-->

<!--                                <tr>-->
<!--                                    <td colspan="2" style="padding:4px 12px;">-->
<!--                                       <strong>Buyer's Date</strong><br/>-->
<!--                                        <strong><t t-esc="delivery.buyer_date" t-options='{"widget": "date","format": "dd-MM-yyyy"}'/></strong>-->
<!--                                    </td>-->
<!--                                </tr>-->
                                <tr>
                                    <td colspan="2">
                                        <div style="text-align: left;font-size:18px;padding:4px 12px;">
                                            <strong>Shipping To</strong>
                                        </div>

                                        <div style="text-align: left; padding-left: 90px;font-size:16px">
                                            <t t-esc="o.partner_shipping_id.name"/>
                                            <br/>
                                            <t t-if="o.partner_shipping_id.street">
                                                <t t-esc="o.partner_shipping_id.street"/>
                                                <br/>
                                            </t>
                                            <t t-if="o.partner_shipping_id.street2">
                                                <t t-esc="o.partner_shipping_id.street2"/>
                                                <br/>
                                            </t>
                                            <t t-if="o.partner_shipping_id.city">
                                                <t t-esc="o.partner_shipping_id.city"/>
                                                <span>,</span>
                                                <t t-esc="o.partner_shipping_id.zip"/>

                                                <br/>
                                            </t>
                                            <t t-if="o.partner_shipping_id.state_id">
                                                <t t-esc="o.partner_shipping_id.state_id.name"/>

                                            </t>
                                            <t t-if="o.partner_shipping_id.country_id">
                                                <t t-esc="o.partner_shipping_id.country_id.name"/>
                                                <br/>
                                            </t>
                                            <t t-if="o.partner_id.phone">
                                            <strong>Ph:</strong>
                                            <t t-esc="o.partner_shipping_id.phone"/>
                                            <br/>
                                            </t>
                                        </div>
                                        <br/>
                                    </td>
                                    <td colspan="4">
                                        <div style="text-align: left;font-size:18px;padding:4px 12px;">
                                            <strong>Buyer</strong>
                                        </div>

                                        <div style="text-align: left; padding-left:70px;font-size:16px;">
                                            <t t-esc="o.partner_id.name"/>
                                            <br/>
                                            <t t-if="o.partner_shipping_id.street">
                                                <t t-esc="o.partner_shipping_id.street  "/>
                                                <br/>
                                            </t>
                                            <t t-if="o.partner_id.street2">
                                                <t t-esc="o.partner_id.street2"/>
                                                <br/>
                                            </t>
                                            <t t-if="o.partner_id.city">
                                                <t t-esc="o.partner_id.city"/>
                                                <span>,</span>
                                                <t t-esc="o.partner_id.zip"/>

                                                <br/>
                                            </t>
                                            <t t-if="o.partner_id.state_id">
                                                <t t-esc="o.partner_id.state_id.name"/>

                                            </t>
                                            <t t-if="o.partner_id.country_id">
                                                <t t-esc="o.partner_id.country_id.name"/>
                                                <br/>
                                            </t>
                                            <t t-if="o.partner_id.phone">
                                            <strong>Ph:</strong>
                                            <t t-esc="o.partner_id.phone"/>
                                            <br/>
                                            </t>
                                            <t t-if="account.acc_number">
                                                <strong>A/C No.:</strong>
                                                <t t-esc="account.acc_number"/>
                                                <br/>
                                            </t>
                                            <t t-if="account.bank_id.bic">
                                                <strong>SWIFT:</strong>
                                                <t t-esc="account.bank_id.bic"/>
                                            </t>
                                        </div>
                                        <br/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding:4px 12px;">
                                           <strong>Pre-Carriage by</strong>
                                                    <br/>
                                                    <span>
                                                        <t t-esc="delivery.pre_carraige"/>
                                                    </span>
                                    </td>
                                    <td style="padding:4px 12px;">
                                        <strong>Place of Receipt</strong>
                                                    <br/>
                                                    <span>
                                                        <t t-esc="delivery.place_of_receipt"/>
                                                    </span>
                                    </td>
                                    <td colspan="2" style="padding:4px 12px;">
                                        <strong>Country of Origin</strong>
                                                            <br/>
                                                            <span>
                                                                <t t-esc="delivery.country_of_origin.name"/>
                                                            </span>
                                    </td>
                                    <td colspan="2" style="padding:4px 12px;">
                                        <strong>Country Destination</strong>
                                                            <br/>
                                                            <span>
                                                                <t t-esc="delivery.country_of_dest.name"/>
                                                            </span>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding:4px 12px;">
                                            <strong>Vessel / Flight No.</strong>
                                                    <br/>
                                                    <span>
                                                        <t t-esc="delivery.flight_no"/>
                                                    </span>
                                    </td>
                                    <td style="padding:4px 12px;">
                                       <strong>Port of Loading</strong>
                                                    <br/>
                                                    <span>
                                                        <t t-esc="delivery.port_of_loading"/>
                                                    </span>
                                    </td>
                                    <td colspan="4" style="padding:4px 12px;">
                                      <strong>Delivery Terms</strong>
                                                    <br/>
                                                    <t t-esc="o.invoice_incoterm_id.name"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding:4px 12px;">
                                            <strong>Port of Discharge</strong>
                                                    <br/>
                                                    <span>
                                                        <t t-esc="delivery.port_of_discharge"/>
                                                    </span>
                                    </td>
                                    <td style="padding:4px 12px;">
                                        <strong>Place of Discharge</strong>
                                                    <br/>
                                                    <span>
                                                        <t t-esc="delivery.place_of_discharge"/>
                                                    </span>
                                    </td>
                                    <td colspan="4" style="padding:4px 12px;">
                                      <strong>Payment Terms</strong>
                                                    <br/>
                                                    <t t-esc="o.invoice_payment_term_id.name"/>
                                    </td>

                                </tr>
                                <tr>
                                    <td style="width: 25%;padding:4px 12px;">
                                         <strong>Marks and Nos.</strong>
                                        <br/>
                                        <span>
                                            <t t-esc="delivery.marks_no"/>
                                        </span>
                                    </td>
                                    <td style="width: 25%;padding:4px 12px;">
                                        <strong>Container No.</strong>
                                        <br/>
                                        <span>
                                            <t t-esc="delivery.container_no"/>
                                        </span>
                                    </td>
                                    <td colspan="2" style="width: 25%;padding:4px 12px;">
                                        <strong>No.of Pkgs.</strong>
                                        <br/>

                                        <span>
                                            <t t-esc="delivery.no_pkgs"/>
                                        </span>
                                    </td>
                                    <td colspan="2" style="width: 25%;padding:4px 12px;">
                                       <strong>Kind of Pkgs</strong>
                                        <br/>

                                        <span>
                                            <t t-esc="delivery.pkgs_kind"/>
                                        </span>
                                    </td>
                                </tr>


                            </table>

                            <table class="table"
                                   style="width:100%; border: 1px; border-collapse: collapse;">
<!--                                <thead>-->
                                    <tr>
                                        <th style="text-align:center;">Sl No.</th>
                                        <th style="text-align:left;">Description of Goods</th>
                                        <th style="text-align:center;">Quantity</th>
                                        <th style="text-align:center;">Weight(Kg)</th>
                                        <th style="text-align:right;">Rate</th>
                                        <th style="text-align:right;">Amount</th>
                                        <!--                                        <th>Amount(Tax incl.)</th>-->
                                    </tr>
<!--                                </thead>-->
                                <tbody style="font-size:15px;font-weight:normal">
                                    <t t-set="count" t-value="1"/>
                                    <t t-set="total_qty" t-value="0"/>
                                    <t t-set="net_weight" t-value="0"/>
                                    <t t-set="amount" t-value="0"/>
                                    <t t-set="total_gross" t-value="0"/>
                                    <t t-foreach="o.invoice_line_ids" t-as="line">
                                        <tr>
                                            <td style="width:7%;text-align:center;">
                                                <span>
                                                    <t t-esc="count"/>
                                                </span>
                                            </td>
                                            <td style="width:43%;text-align:left;">
                                                <span>
                                                    <t t-esc="line.name"/>
                                                </span>
                                            </td>
                                            <td style="text-align:center;">
                                                <span>
                                                    <t t-esc="line.quantity"/>
                                                </span>
                                            </td>
                                            <td style="text-align:center;">
                                                <t t-set="wgt" t-value="0"/>
                                                <t t-set="wgt" t-value="line.quantity*line.product_id.weight"/>
                                                <span>
                                                    <t t-esc="'%.3f'%wgt"/>
                                                </span>
                                            </td>
                                            <td style="text-align:right;">
                                                <span>
<!--                                                    <t t-esc="line.currency_id.symbol"/>-->
<!--                                                    <t t-esc="line.price_unit"/>-->
                                                    <t t-esc="line.price_unit" t-options='{"widget": "monetary", "display_currency": line.currency_id}'/>
                                                </span>
                                            </td>
                                             <td style="text-align:right;">
                                                <span>
<!--                                                    <t t-esc="line.currency_id.symbol"/>-->
<!--                                                    <t t-esc="line.price_total"/>-->
                                                    <t t-esc="line.price_total" t-options='{"widget": "monetary", "display_currency": line.currency_id}'/>

                                                </span>
                                            </td>
                                        </tr>
                                        <t t-set="count" t-value="count+1"/>
                                        <t t-set="total_qty" t-value="total_qty+line.quantity"/>
                                        <t t-set="net_weight" t-value="net_weight+wgt"/>
                                        <t t-set="amount" t-value="amount+line.price_total"/>
                                        <t t-set="total_gross" t-value="total_gross+line.gross_weight"/>
                                    </t>

                                </tbody>
                            </table>
                            <table style="width: 63%; border-collapse: collapse;">
                                <tr>
                                    <td style="text-align: left; padding: 8px;">
                                        <strong>TOTAL PIECES:</strong>
                                    </td>
                                    <td style="text-align: right; padding: 8px;">
                                        <span>
                                            <t t-esc="'%.3f'% total_qty"/>
                                        </span>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="text-align: left; padding: 8px;">
                                        <strong>TOTAL NET WEIGHT(Kg):</strong>
                                    </td>
                                    <td style="text-align: right; padding: 8px;">
                                        <span>
                                            <t t-esc="'%.3f'% net_weight"/>
                                        </span>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="text-align: left; padding: 8px;">
                                        <strong>TOTAL GROSS WEIGHT(Kg):</strong>
                                    </td>
                                    <td style="text-align: right; padding: 8px;">
                                        <span>
                                            <t t-esc="'%.3f'%delivery.total_gross"/>
                                        </span>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="text-align: left; padding: 8px;">
                                        <strong>TOTAL C.I.F VALUE IN US DOLLARS:</strong>
                                    </td>
                                    <td style="text-align: right; padding: 8px;">
                                        <span>
<!--                                            <t t-esc="line.currency_id.symbol"/>-->
<!--                                            <t t-esc="'%.2f'% amount"/>-->
                                            <t t-esc="amount" t-options='{"widget": "monetary", "display_currency": line.currency_id}'/>

                                        </span>
                                    </td>
                                </tr>

                            </table>
                            <br/>
                            <br/>
                            <div>
                                        <strong>TOTAL AMOUNT IN WORDS: </strong><t t-esc="line.currency_id.amount_to_text(amount)"/>
                            </div>

                        </t>
                    </t>
                    <t t-if="sale_orders">
                            <div style="width:50%;padding-top:30%;font-size:14px">

                                <strong>
                                    <t t-esc="sale_orders.pricelist_id.note"/>
                                </strong>
                            </div>
                    </t>
                    <div class="footer">
                        <div class="text-center" style="border-top: 1px solid black; padding-top: 10px;font-size:14px;color: #666;font-weight:bold">
                           <span>
                                    <t t-esc="o.company_id.phone"/>
                           </span>
                            <span style="margin-left: 20px;">
                                <t t-esc="o.company_id.email"/>
                            </span>
                            <span style="margin-left: 20px;">
                                <t t-esc="o.company_id.website"/>
                            </span>
                        </div>
                    </div>

                </div>
            </t>
        </t>
    </template>


</odoo>
