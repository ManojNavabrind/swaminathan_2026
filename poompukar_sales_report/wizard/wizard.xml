<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="sales_report_wizard" model="ir.ui.view">
            <field name="name">sale.report.wizard</field>
            <field name="model">sale.report.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="customer" widget="many2many_tags" domain="[('category_id.name','=','Poompuhar Sales')]"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <footer>
                         <button name="sales_report" string="Print PDF" type="object"/>
                    </footer>

                </form>
            </field>
        </record>

        <record id="action_sales_report" model="ir.actions.act_window">
            <field name="name">Poompuhar Sales Report</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">sale.report.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

         <menuitem id="menu_sales_report" name="Poompuhar Sales Report" action="action_sales_report" parent="sale.menu_sale_report" sequence="50" />

    </data>
</odoo>
