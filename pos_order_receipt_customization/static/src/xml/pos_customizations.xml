                            <td class="pos-center-align" style="text-align:center;border-right:1px solid black;">
                                <t t-esc="vals"/>
                            </td>
                            <td style="padding-top: 1%;padding-left:2%;padding-bottom: 1%;border-right:1px solid black;">
                                <t t-esc="orderline.productName"/>
