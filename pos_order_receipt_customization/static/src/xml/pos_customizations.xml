                            <th width='37%' style="text-align:center; border:1px solid black;font-weight: 600;">Description-Code</th>
                            <th width='12%' style="text-align:center;border:1px solid black; font-weight: 600;">Qty</th>
                            <th width='12%'
                                style="text-align:center; border:1px solid black;font-weight: 600;">Weight</th>
                            <th width='12%'
