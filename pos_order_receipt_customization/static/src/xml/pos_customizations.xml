                                    </t>
                                <t t-else="">
                                        <span style="padding-left:10px;">  </span>
                                    </t>
                                </td>
                            <td class="pos-center-align" style=" padding-right:1%;text-align:right;">
                                <t t-esc="orderline.price_with_tax"/>
                            </td>
                            <t t-set="vals" t-value="vals+1"/>

