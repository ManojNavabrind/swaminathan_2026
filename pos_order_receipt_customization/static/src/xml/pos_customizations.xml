                                <t t-if="orderline.customerNote">
                                    <div style="font-size: 14px;text-align:center" t-esc="orderline.customerNote"/>
                                </t>
                            </td>
                            <td style="text-align:center;border-right:1px solid black; "
                                class="pos-center-align price-per-unit">
                                <t t-if="orderline.sec_uom">
                                    <t t-if="orderline.sec_uom[1] == 'Piece'">
                                        <t t-esc="Math.round(orderline.factor)"/> <!--<t t-esc="orderline.sec_uom[1]" />-->
                                        <t t-esc="orderline.id"/>
                                        <t t-set="total_sec_qty"
                                           t-value="total_sec_qty + (orderline.sec_uom[1] == 'Piece' ? Math.round(orderline.factor) : 0)"/>
                                    </t>

                                    <t t-elif="orderline.secondary_unit_name == 'Piece'">
                                        <t t-esc="Math.round(orderline.qty)"/> <!--<t t-esc="orderline.secondary_unit_name"/>-->
                                        <t t-esc="orderline.id"/>
                                        <t t-set="total_sec_qty"
                                           t-value="total_sec_qty + (orderline.secondary_unit_name == 'Piece' ? (Math.round(orderline.qty)) : 0)"/>
                                    </t>

                                    <t t-else="">
                                        <span style="padding-left:10px;"> - </span>
                                    </t>
                                    <!--                                    <t t-set="total_qty" t-value="total_qty + (orderline.sec_uom[1] == 'Kg' ? (Math.round(orderline.factor * 1000)/1000) : 0)"/>-->
                                </t>

                                <t t-elif="orderline.unit == 'Piece'">
                                        <t t-esc="Math.round(orderline.qty)"/> <!--<t t-esc="orderline.unit"/>-->
                                    <t t-esc="orderline.id"/>
                                    <t t-set="total_sec_qty"
                                       t-value="total_sec_qty + (orderline.unit == 'Piece' ? (Math.round(orderline.qty)) : 0)"/>
                                </t>
                                <!--                                <t t-else="">-->
                                <!--                                   <span style="padding-left:10px;">  </span>-->
