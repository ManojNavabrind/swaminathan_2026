                                    <!--                                    <t t-set="total_qty" t-value="total_qty + (orderline.secondary_unit_name == 'Kg' ? (Math.round(orderline.qty * 1000)/1000) : 0)"/>-->
                                    <!--                                    <t t-set="total_sec_qty" t-value="total_sec_qty + (orderline.secondary_unit_name == 'Piece' ? Math.round(orderline.qty) : 0)"/>-->
                                </t>
                                    <!--                                <t t-else="">-->
                                    <!--                                    <span style="padding-left:10px;">  </span>-->
                                    <!--                                </t>-->
                                </span>
                            </td>

                            <td class="pos-center-align"
