<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="purchase_report_inherit" inherit_id="purchase.report_purchaseorder_document">

          <xpath expr="//table[contains(@class,'table')]" position="before">
            <t t-set="serial_no" t-value="1"/>
        </xpath>

        <xpath expr="//th[@name='th_description']" position="before">
             <th style="width:5%; text-align:center;"><strong>S.No</strong></th>
            <th style="width:15%; text-align:center;"><strong>Barcode</strong></th>
            <th style="width:10%; text-align:center;"><strong>Image</strong></th>
        </xpath>

        <xpath expr="//span[@t-field='line.name']/parent::td" position="before">
            <td style="vertical-align:middle; text-align:center;">
                <span t-esc="serial_no"/>
                <t t-set="serial_no" t-value="serial_no + 1"/>
            </td>
            <td style="vertical-align:middle; text-align:center;">
                <span t-field="line.product_id.barcode"/>
            </td>
            <td style="vertical-align:middle; text-align:center;">
                <img t-if="line.product_id.image_128"
                     t-att-src="image_data_uri(line.product_id.image_128)"
                     style="max-height: 50px; max-width: 50px;"/>
            </td>
        </xpath>

    </template>
</odoo>
