<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_saleorder_document_inherit" inherit_id="sale.report_saleorder_document">
        <xpath expr="//t[@t-set='address']" position="before">
            <style>
                .th{
                    width:30%;
                    color:red;
                }
            </style>
        </xpath>
        <xpath expr="//table[hasclass('o_main_table')]/thead/tr/th[1]" position="before">
            <t t-if="doc.print_image and doc.image_sizes in ('image', 'image_medium', 'image_small') ">
                <th>Sl.No</th>
                <th>Barcode</th>
                <th>Product Image</th>
            </t>
        </xpath>
        <xpath expr="//table[hasclass('o_main_table')]/thead/tr/th[2]" position="after">
            <th>Weight</th>
        </xpath>
        <xpath expr="//table/tbody[hasclass('sale_tbody')]" position="replace">
            <tbody class="sale_tbody">

                <t t-set="current_subtotal" t-value="0"/>
                <t t-set="count" t-value="1"/>

                <t t-foreach="lines_to_report" t-as="line">

                    <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal"/>

                    <tr t-att-class="'bg-200 fw-bold o_line_section' if line.display_type == 'line_section' else 'fst-italic o_line_note' if line.display_type == 'line_note' else ''">
                        <t t-if="not line.display_type">
                            <td name="td_sl_no">
                                <t t-esc="count"/>
                                <t t-set="count" t-value="count+1"/>
                            </td>
                            <td name="td_barcode">
                                <span t-field="line.product_template_id.barcode"/>
                            </td>
                            <t t-if="doc.image_sizes == 'image' and doc.print_image ">
                                <td class="text-center">
                                    <img t-if="line.product_id.image_1920"
                                         t-attf-src="data:image/*;base64,{{line.product_id.image_1920}}"
                                         style="resize:both;width:40px;height:40px"/>
                                </td>
                            </t>
                            <t t-if="doc.image_sizes == 'image_medium' and doc.print_image">
                                <td class="text-center">
                                    <img t-if="line.product_id.image_1920"
                                         t-attf-src="data:image/*;base64,{{line.product_id.image_1920}}"
                                         style="resize:both;width:40px;height:40px"/>
                                </td>

                            </t>
                            <t t-if="doc.image_sizes == 'image_small' and doc.print_image ">
                                <td class="text-center">
                                    <img t-if="line.product_id.image_1920"
                                         t-attf-src="data:image/*;base64,{{line.product_id.image_1920}}"
                                         style="resize:both;width:40px;height:40px"/>
                                </td>
                            </t>
                            <td name="td_name">
                                <span t-field="line.name">Bacon Burger</span>
                            </td>

                            <td name="td_quantity" class="text-end">
                                    <t t-if="line.sell_in_unit">
                                    <span t-esc="'%.0f' % line.secondary_qty"/>
                                </t>
                                <t t-else="">
                                    <span t-esc="'%.0f' % line.product_uom_qty"/>
                                </t>

                                <span t-field="line.product_uom"/>
                            </td>
                            <!-- Weight Column -->
                            <td name="td_weight" class="text-end">
                                <t t-if="line.product_uom.name == 'Kg'">
                                    <span t-esc="'%.3f' % line.product_uom_qty"/>
                                    <span style="vertical-align: baseline;">Kg</span>
                                </t>
                            </td>
                            <td name="td_priceunit" class="text-end">
                                    <t t-if="line.sell_in_unit">
                                    <span t-esc="round(line.price_subtotal / line.secondary_qty, 2)"/>
                                </t>
                                <t t-else="">
                                    <span t-field="line.price_unit"/>
                                </t>
                            </td>
                            <td t-if="display_discount" class="text-end">
                                <span t-field="line.discount">-</span>
                            </td>
                            <t t-set="taxes"
                               t-value="', '.join([(tax.invoice_label or tax.name) for tax in line.tax_id])"/>
                            <td name="td_taxes"
                                t-attf-class="text-end {{ 'text-nowrap' if len(taxes) &lt; 10 else '' }}">
                                <span t-out="taxes">Tax 15%</span>
                            </td>
                            <td t-if="not line.is_downpayment" name="td_subtotal" class="text-end o_price_total">
                                <span t-field="line.price_subtotal">27.00</span>
                            </td>
                        </t>
                        <t t-elif="line.display_type == 'line_section'">
                            <td name="td_section_line" colspan="99">
                                <span t-field="line.name">A section title</span>
                            </td>
                            <t t-set="current_section" t-value="line"/>
                            <t t-set="current_subtotal" t-value="0"/>
                        </t>
                        <t t-elif="line.display_type == 'line_note'">
                            <td name="td_note_line" colspan="99">
                                <span t-field="line.name">A note, whose content usually applies to the section or
                                    product above.
                                </span>
                            </td>
                        </t>
                    </tr>

                    <t t-if="current_section and (line_last or lines_to_report[line_index+1].display_type == 'line_section') and not line.is_downpayment">
                        <tr class="is-subtotal text-end">
                            <td name="td_section_subtotal" colspan="99">
                                <strong class="mr16">Subtotal</strong>
                                <span
                                        t-out="current_subtotal"
                                        t-options='{"widget": "monetary", "display_currency": doc.currency_id}'
                                >31.05
                                </span>
                            </td>
                        </tr>
                    </t>
                </t>
            </tbody>
        </xpath>
