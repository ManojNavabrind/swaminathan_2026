<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="sh_pos_secondary.UpdateQtyPopup" owl="1">
   <div class="popup custom_popup">
       <div class="modal-header justify-content-center">
            <h2 class="modal-title">
               <t t-esc="props.title"/>
            </h2>
         </div>

       <div class="modal-body custom-form-view">
        <form>
         <div class="col d-flex justify-content-between align-items-center p-3">
             <label class="form-label label" for="secondary_uom">Secondary UoM</label>
             <input type="text" class="w-75 form-control" name="secondary_uom"
                    t-att-value="props.secondary_uom.display_name"/>
         </div>
            <div class="col d-flex justify-content-between align-items-center p-3">
                <label class="form-label label" for="customer">Quantity</label>
                <input type="text" class="quantity_input w-75 form-control" name="notes" t-att-value="props.factor"/>
            </div>
        </form>
       </div>
       <div class="footer footer-flex modal-footer justify-content-end">
            <div class="button cancel btn btn-lg btn-primary"
                 t-on-click="cancel">
               <t t-esc="props.closePopup"/>
            </div>
           <div class="button cancel btn btn-lg btn-primary"
                t-on-click="update">
              <t t-esc="props.confirmText"/>
            </div>
         </div>
       </div>
   </t>
</templates>

