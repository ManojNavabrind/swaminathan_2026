<?xml version="1.0" encoding="UTF-8"?>
<templates id="product_info_template" xml:space="preserve">

    <t t-name="product_info_details" t-inherit="point_of_sale.ProductInfoPopup" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('section-financials')]" position='after'>
                        <div class="section-secondary-uom-details mt-3 mb-4 pb-4 border-bottom text-start">
                            <h3 class="section-title">Secondary UOM Info</h3>
                            <table class="table table-borderless mb-0">
                                <tr>
                                    <td>Secondary UOM</td>
                                    <td><t t-esc="props.product.secondary_uom[1]"/></td>
                                </tr>
                                <tr>
                                    <td>Ratio</td>
                                    <td><t t-esc="props.product.factor"/></td>
                                </tr>
                                <tr>
                                    <td>Secondary Sales price</td>
                                    <td><t t-esc="env.utils.formatCurrency(props.product.secondary_sale_price)"/></td>
                                </tr>
                            </table>
                        </div>
        </xpath>
         <xpath expr="//div[hasclass('section-inventory-body')]" position='replace'>
             <div class="section-inventory-body">
                            <t t-foreach="productInfo.warehouses" t-as="warehouse" t-key="warehouse.name">
                                <div class="d-flex flex-column flex-md-row gap-2">
                                    <div>
                                        <t t-esc="warehouse.name" class="table-name"/>
                                        :
                                    </div>
                                    <div>
                                        <span class="me-1 fw-bolder"> <t t-esc="warehouse.secondary_qty" class="table-name"/></span>
                                        <t t-esc="warehouse.secondary_uom"/> available,
                                        <span class="me-1 fw-bolder"><t t-esc="warehouse.available_quantity" class="table-name"/></span>
                                        <t t-esc="warehouse.uom"/> available,
                                    </div>
                                    <div>
                                        <span class="me-1 fw-bolder"><t t-esc="warehouse.forecasted_quantity"/></span>
                                        forecasted
                                    </div>
                                </div>
                            </t>
                        </div>
         </xpath>
    </t>


</templates>