<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="sh_pos_secondary_pos_details" model="ir.ui.view">
        <field name="name">pos.config.settings.secondary.form.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <block id="pos_interface_section" position="after">
                <block title="UOM Settings">
                    <setting>
                        <field name="pos_select_uom_type" widget="radio" style="width: 180px;"/>
                    </setting>
                    <setting>
                        <field name="pos_display_uom_in_receipt" />
                    </setting>
                    <setting invisible="pos_select_uom_type == 'primary'">
                        <field name="pos_enable_price_to_display" />
                    </setting>
                </block>
            </block>
        </field>
    </record>
</odoo>
